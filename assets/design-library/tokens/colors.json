{
  "$schema": "https://design-tokens.org/schema",
  "description": "Design tokens de cor — rAIz Educação. Fonte de verdade machine-readable; UI_UX/raiz-educacao-design-system.md tem a versão human-readable.",
  "brand": {
    "orange": {
      "base": { "hex": "#F7941D", "cssVar": "--raiz-orange", "usage": "CTA principal, active state, badges, accents" },
      "dark": { "hex": "#D97B10", "cssVar": "--raiz-orange-dark", "usage": "Hover, pressed" },
      "light": { "hex": "#FDE8C8", "cssVar": "--raiz-orange-light", "usage": "Background tint para alerts e highlights" }
    },
    "teal": {
      "base": { "hex": "#5BB5A2", "cssVar": "--raiz-teal", "usage": "Accent, secondary" },
      "dark": { "hex": "#3D9A87", "cssVar": "--raiz-teal-dark", "usage": "Hover teal" },
      "light": { "hex": "#D4EFE9", "cssVar": "--raiz-teal-light", "usage": "Background tint info" }
    }
  },
  "semantic": {
    "background": { "light": "#F8F9FA", "dark": "#0a0a0a", "usage": "App background" },
    "surface": { "light": "#FFFFFF", "dark": "#1a1a1a", "usage": "Cards, panels" },
    "foreground": { "light": "#1A202C", "dark": "#fafafa", "usage": "Text primary" },
    "muted": { "light": "#718096", "dark": "#a1a1aa", "usage": "Text secondary" },
    "border": { "light": "#E2E8F0", "dark": "rgba(255,255,255,0.1)", "usage": "Borders, dividers" },
    "sidebar": { "light": "#1E2433", "dark": "#1a1a1a", "usage": "Sidebar background" }
  },
  "status": {
    "success": { "hex": "#2D9E6B", "usage": "Confirmations, active" },
    "warning": { "hex": "#E8A820", "usage": "Alerts, limits" },
    "danger":  { "hex": "#DC3545", "usage": "Errors, deletions" },
    "info":    { "hex": "#3B82F6", "usage": "Neutral metrics" }
  }
}
