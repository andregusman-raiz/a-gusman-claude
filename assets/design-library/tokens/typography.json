{
  "description": "Escala tipográfica rAIz Educação — base 16px, Montserrat (canonical guia 16.2-16.3) + IBM Plex Mono.",
  "fonts": {
    "sans":    { "family": "Montserrat", "fallback": "Helvetica, ui-sans-serif, system-ui, sans-serif", "cssVar": "--font-sans", "weight_regular": 400, "weight_bold": 700 },
    "mono":    { "family": "IBM Plex Mono", "fallback": "ui-monospace, monospace", "cssVar": "--font-mono" },
    "heading": { "family": "Montserrat", "fallback": "Helvetica, ui-sans-serif, system-ui, sans-serif", "cssVar": "--font-heading", "weight_regular": 400, "weight_bold": 700 }
  },
  "scale": [
    { "token": "text-xs",     "size": "10-11px", "weight": "400-600", "lineHeight": "1.4-1.5", "usage": "Labels, micro-copy" },
    { "token": "text-sm",     "size": "13-14px", "weight": "400-500", "lineHeight": "1.5",     "usage": "Nav items, body compact" },
    { "token": "text-base",   "size": "16px",    "weight": "400-500", "lineHeight": "1.6",     "usage": "Body standard, form labels" },
    { "token": "text-xl",     "size": "20px",    "weight": "600",     "lineHeight": "1.3",     "usage": "Page titles (h1)" },
    { "token": "text-2xl",    "size": "24px",    "weight": "700",     "lineHeight": "1.2",     "usage": "Section titles" },
    { "token": "text-[30px]", "size": "30px",    "weight": "700",     "lineHeight": "1.0",     "usage": "Large KPI values" }
  ],
  "logoTypography": {
    "RAIZ":     { "weight": 900, "letterSpacing": "-0.5" },
    "educação": { "weight": 400, "letterSpacing": "1.5-1.8" }
  },
  "presentation": {
    "description": "Escala canonical guia mestre seções 16.2/16.3 — usada por skill ag-5-documentos modo executive.",
    "kicker":    9,
    "caption":   9,
    "body_sm":  12,
    "body":     14,
    "subtitle": 16,
    "takeaway": 14,
    "label":    14,
    "h3":       16,
    "h2":       20,
    "h1":       28,
    "section":  36,
    "hero":     40,
    "hero_xl":  56,
    "table":    11
  }
}
